--- linux-3.14/fs/nfsd/nfsxdr.c.orig	2014-04-03 11:54:17.530971880 -0400
+++ linux/fs/nfsd/nfsxdr.c	2014-04-03 12:11:45.090974990 -0400
@@ -152,7 +152,8 @@
 	type = (stat->mode & S_IFMT);
 
 	*p++ = htonl(nfs_ftypes[type >> 12]);
-	*p++ = htonl((u32) (stat->mode & S_IALLUGO));
+	printk(KERN_INFO "%s: mode=0x%08x mask=0x%08x\n", __func__, stat->mode, S_IALLUGO);  //DEBUG
+	*p++ = htonl((u32) stat->mode);
 	*p++ = htonl((u32) stat->nlink);
 	*p++ = htonl((u32) from_kuid(&init_user_ns, stat->uid));
 	*p++ = htonl((u32) from_kgid(&init_user_ns, stat->gid));

