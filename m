reg 0, base: 0GB, range: 512MB, type WB
reg 1, base: 511MB, range: 1MB, type UC
total RAM covered: 511M
 gran_size: 64K 	chunk_size: 64K 	num_reg: 0  	lose cover RAM: 511M
