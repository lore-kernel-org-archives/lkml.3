> +	if (!ns)
> +		ns = current_user_ns()->syslog_ns;
> +
> +#ifdef CONFIG_KGDB_KDB
> +	if (unlikely(kdb_trap_printk)) {
> +		va_start(args, fmt);
> +		r = vkdb_printf(fmt, args);
> +		va_end(args);
> +		return r;
> +	}
> +#endif
> +	va_start(args, fmt);
> +	r = ns_vprintk_emit(0, -1, NULL, 0, fmt, args, ns);
> +	va_end(args);
> +
> +	return r;
> +}
> +EXPORT_SYMBOL(ns_printk);
