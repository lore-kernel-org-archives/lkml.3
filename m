> +	ret = da9052_reg_read(rtc->da9052, DA9052_ALARM_Y_REG);
>  	if (ret < 0) {
> -		rtc_err(da9052, "Failed to read ALM: %d\n", ret);
> +		rtc_err(rtc, "Failed to read ALM: %d\n", ret);
>  		return ret;
>  	}
