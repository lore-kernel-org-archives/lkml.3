/*
 * soc-camera OV2640
 */
#if defined(CONFIG_SOC_CAMERA_OV2640) || \
	defined(CONFIG_SOC_CAMERA_OV2640_MODULE)
static unsigned long isi_camera_query_bus_param(struct soc_camera_link *l=
ink)
{
	/* ISI board for ek using default 8-bits connection */
	return SOCAM_DATAWIDTH_8;
}

static int i2c_camera_power(struct device *dev, int on)
{
	/* enable or disable the camera */
	pr_debug("%s: %s the camera\n", __func__, on ? "ENABLE" : "DISABLE");
	at91_set_gpio_output(AT91_PIN_PD13, !on);

	if (!on)
		goto out;

	/* If enabled, give a reset impulse */
	at91_set_gpio_output(AT91_PIN_PD12, 0);
	msleep(20);
	at91_set_gpio_output(AT91_PIN_PD12, 1);
	msleep(100);

out:
	return 0;
}

static struct i2c_board_info i2c_camera =3D {
	I2C_BOARD_INFO("ov2640", 0x30),
};

static struct soc_camera_link iclink_ov2640 =3D {
	.bus_id			=3D 0,
	.board_info		=3D &i2c_camera,
	.i2c_adapter_id		=3D 0,
	.power			=3D i2c_camera_power,
	.query_bus_param	=3D isi_camera_query_bus_param,
};

static struct platform_device isi_ov2640 =3D {
	.name	=3D "soc-camera-pdrv",
	.id	=3D 0,
	.dev	=3D {
		.platform_data =3D &iclink_ov2640,
	},
};
