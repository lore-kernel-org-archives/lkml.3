+		RSND_GEN1_M_REG(gen,  SRU,	BUSIF_MODE,	0x20,	0x4),
+		RSND_GEN1_M_REG(gen,  SRU,	BUSIF_ADINR,	0x214,	0x40),
+
+		RSND_GEN1_S_REG(gen, ADG,	BRRA,		0x00),
