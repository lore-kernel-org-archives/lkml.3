 arch/arm/mach-at91/at91rm9200.c         |  341 ---------
 arch/arm/mach-at91/at91rm9200_devices.c | 1212 -------------------------------
 6 files changed, 1835 deletions(-)
 delete mode 100644 arch/arm/configs/at91rm9200_defconfig
