> SCHED_POWER_SHIFT)
> -				/ (p->se.avg.runnable_avg_period +
> 1);
> +	unsigned putil;
> +	putil = div_u64(((u64)p->se.avg.runnable_avg_sum <<
> SCHED_POWER_SHIFT),
> +				p->se.avg.runnable_avg_period + 1);
>  
