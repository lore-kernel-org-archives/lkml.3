> +
> +	trace_seq_printf(s, " expires=");
> +	pevent_print_num_field(s, "%llu", event, "expires", record, 1);
> +
> +	trace_seq_printf(s, " softexpires=");
> +	pevent_print_num_field(s, "%llu", event, "softexpires", record, 1);
