 arch/arm/mach-at91/at91sam9260.c            |  397 --------
 arch/arm/mach-at91/at91sam9260_devices.c    | 1364 ---------------------------
 5 files changed, 2024 deletions(-)
 delete mode 100644 arch/arm/configs/at91sam9260_9g20_defconfig
