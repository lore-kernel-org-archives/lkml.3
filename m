-#define A3D_MAX_STROBE		80	/* 80 us */
-#define A3D_MAX_LENGTH		40	/* 40*3 bits */
-
-#define A3D_MODE_A3D		1	/* Assassin 3D */
-#define A3D_MODE_PAN		2	/* Panther */
